PORT=3001
MONGODB_URI=mongodb://localhost:27017/moonscale-erp
JWT_SECRET=change-this-to-a-strong-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-this-to-another-strong-secret
JWT_REFRESH_EXPIRES_IN=7d

# SMTP LWS
SMTP_HOST=mail.lws.fr
SMTP_PORT=587
SMTP_USER=votre-email@votredomaine.com
SMTP_PASS=votre-mot-de-passe

FRONTEND_URL=http://localhost:5173

# ─── LLM (utilisé par WhatsApp Assistant + Content Tracking) ───
GROQ_API_KEY=
GEMINI_API_KEY=
# Anthropic — laisse vide tant que la clé n'est pas dispo (fallback)
ANTHROPIC_API_KEY=

# ─── Content Tracking — scrapers ───
# YouTube ET TikTok passent par yt-dlp (bundlé via youtube-dl-exec, aucune clé requise).
# Si tu veux un jour basculer sur une API REST tierce (YouTube Data API, TikAPI, etc.),
# ré-introduire les vars ici (ex: YOUTUBE_API_KEY=, TIKTOK_SCRAPER_API_KEY=).
